# -------------------------------------------------------------------
# Backend environment variables
# Copy this file to `.env` and fill in real values.
# -------------------------------------------------------------------

# --- Core ---
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins. The first entry is also
# used as the public site URL inside emails / password-reset links.
CLIENT_URL=http://localhost:5173

# --- Database ---
# Get this from MongoDB Atlas → Database → Connect → "Drivers"
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/realestate?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Set to "true" only behind HTTPS in production.
COOKIE_SECURE=false

# --- Cloudinary (image hosting) ---
# Sign up at https://cloudinary.com/ and copy the credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy alias kept for backward compatibility with older config files.
CLOUDINARY_NAME=

# --- SMTP (Nodemailer) ---
# For Gmail use an "App password" (https://support.google.com/accounts/answer/185833).
# For dev/testing, https://mailtrap.io works great.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Telvine Realty <no-reply@telvine.local>"
